    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "editorMode": "code",
     "expr": "sum(count_over_time({service_name=\"anki-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | status=\"ok\" [$__auto]))",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "ok"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "editorMode": "code",
     "expr": "sum(count_over_time({service_name=\"anki-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | status=\"error\" [$__auto]))",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "error"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 30,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Latency by tool (p95)",
   "id": 9,
   "description": "95th percentile duration. add_note is the one that matters — it is the capture path from the phone.",
   "datasource": {
    "type": "loki",
    "uid": "grafanacloud-logs"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "editorMode": "code",
     "expr": "quantile_over_time(0.95, {service_name=\"anki-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | unwrap duration_ms [$__auto]) by (tool)",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "{{tool}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   }
