   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "grafanacloud-logs"
     },
     "editorMode": "code",
     "expr": "sum(count_over_time({service_name=\"anki-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" | status=\"error\" [$__range])) / sum(count_over_time({service_name=\"anki-mcp\", deployment_environment_name=\"$env\"} | tool != \"\" [$__range]))",
     "refId": "A",
     "queryType": "instant",
     "instant": true
