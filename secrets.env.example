# Copy to secrets.env (gitignored) and fill in. This file holds real secrets:
# never commit it. Pass it to the container with --env-file / env_file.

# --- Auth mode --------------------------------------------------------------
# bearer -- one static token. Fine on the tailnet, where the network is the
#           perimeter. Claude Code and Claude Desktop can send the header.
#           If the deployment later goes public, switch back to oauth in the
#           same commit: a bearer endpoint on Funnel still works, it is just
#           far less protected than intended, and nothing will tell you.
# oauth  -- full OAuth 2.1 with a password + TOTP login page. REQUIRED for
#           Claude custom connectors, and therefore required for Claude on
#           Android. The only defensible option on a public Funnel endpoint.
# NOTE: if your compose file also sets ANKI_MCP_AUTH_MODE under `environment:`,
# that wins over this file (compose `environment` overrides `env_file`).
ANKI_MCP_AUTH_MODE=bearer

# --- bearer mode ------------------------------------------------------------
# At least 32 characters, or the server refuses to start.
# Generate with:  openssl rand -hex 32
ANKI_MCP_BEARER_TOKEN=

# --- oauth mode -------------------------------------------------------------
# The login page is the only thing between the internet and your collection,
# so both factors are mandatory and the server will not start without them.
# At least 12 characters.
ANKI_MCP_LOGIN_PASSWORD=
# Base32 "setup key" your authenticator is set up with (e.g. a 1Password
# one-time-password field) -- NOT the 6-digit code. Spaces and lowercase are accepted.
ANKI_MCP_TOTP_SECRET=
# The externally reachable https:// address. Mandatory in oauth mode: OAuth
# redirects and discovery metadata must carry the public hostname.
ANKI_MCP_PUBLIC_URL=

# --- AnkiWeb ----------------------------------------------------------------
# Needed only for the FIRST sync. sync_to_ankiweb exchanges these for a session
# key cached at /config/ankiweb_hkey, after which you can blank them out.
# Accounts with 2FA enabled will not work.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=

# --- Images -----------------------------------------------------------------
# Which provider supplies card pictures. 'auto' chains them best-first:
# Pixabay (if a key is set), then Openverse, then Wikimedia.
#   pixabay   -- free key from https://pixabay.com/api/docs/ ; a photo library
#                built for everyday objects and scenes, searchable in German.
#                Clearly the best relevance -- use this.
#   openverse -- no key, real photography, but intermittently slow.
#   wikimedia -- no key and fast, but its full-text search matches words inside
#                scanned document titles, so it returns archive material rather
#                than pictures of the thing. Fallback only.
#   google    -- Custom Search JSON API. Largely moot since March 2026: Google
#                discontinued "search the entire web", so a new engine is capped
#                at 50 listed domains. Kept for anyone with a legacy engine.
ANKI_MCP_IMAGE_PROVIDER=auto
PIXABAY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# --- Pronunciation ----------------------------------------------------------
# Audio comes from German Wiktionary first -- real German speakers, free, no
# credentials -- and falls back to TTS only for what Wiktionary has no entry
# for, which in practice means phrases.
#
# 'elevenlabs' or 'google'. ElevenLabs has the better German voices, but they
# are LIBRARY voices: the API serves those only to accounts with credit or a
# subscription, so a purely free key can reach just its English-accented
# premade set. Google's de-DE voices are native German and free.
ANKI_MCP_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# No default: every service's default voice is an English speaker, and German
# read with an English accent is the opposite of what these cards are for.
ELEVENLABS_VOICE_ID=
# For ANKI_MCP_TTS_PROVIDER=google instead:
GOOGLE_TTS_API_KEY=
ANKI_MCP_TTS_VOICE=de-DE-Neural2-F

# --- Telemetry (optional) ---------------------------------------------------
# Ships structured logs over OTLP (e.g. to Grafana Cloud). Unset = disabled;
# the server logs to stdout and serves normally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Tags every record; the dashboard's $env variable filters on it.
ANKI_MCP_ENVIRONMENT=production
